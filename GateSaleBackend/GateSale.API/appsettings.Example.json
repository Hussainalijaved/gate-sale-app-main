{
    "ConnectionStrings": {
        "DefaultConnection": "Host=localhost;Port=5432;Database=gatesale_local;Username=postgres;Password=YOUR_PASSWORD;",
        "ProductionConnection": "YOUR_PRODUCTION_CONNECTION_STRING"
    },
    "Logging": {
        "LogLevel": {
            "Default": "Information",
            "Microsoft.AspNetCore": "Warning"
        }
    },
    "Jwt": {
        "Issuer": "YOUR_JWT_ISSUER",
        "Audience": "YOUR_JWT_AUDIENCE"
    },
    "AWS": {
        "Region": "af-south-1",
        "AccessKey": "YOUR_AWS_ACCESS_KEY",
        "SecretKey": "YOUR_AWS_SECRET_KEY",
        "Cognito": {
            "Region": "af-south-1",
            "PoolId": "YOUR_COGNITO_POOL_ID",
            "ClientId": "YOUR_COGNITO_CLIENT_ID",
            "ClientSecret": "YOUR_COGNITO_CLIENT_SECRET",
            "Authority": "YOUR_COGNITO_AUTHORITY"
        },
        "S3": {
            "BucketName": "YOUR_S3_BUCKET_NAME",
            "ServiceURL": "https://s3.af-south-1.amazonaws.com"
        }
    },
    "Pudo": {
        "ApiBaseUrl": "https://api.pudo.com/v1/",
        "ApiKey": "YOUR_PUDO_API_KEY",
        "WebhookSecret": "YOUR_PUDO_WEBHOOK_SECRET",
        "ConnectionTimeoutSeconds": 30,
        "UseSandbox": true
    },
    "AppSettings": {
        "WebsiteUrl": "YOUR_WEBSITE_URL",
        "ApiUrl": "YOUR_API_URL"
    },
    "AllowedHosts": "*",
    "EmailSettings": {
        "SmtpServer": "email-smtp.af-south-1.amazonaws.com",
        "Port": 587,
        "Username": "YOUR_SES_SMTP_USERNAME",
        "Password": "YOUR_SES_SMTP_PASSWORD",
        "SenderEmail": "YOUR_SENDER_EMAIL",
        "SenderName": "GateSale",
        "EnableActualSending": true
    },
    "GoogleSMTP": {
        "SmtpServer": "smtp.gmail.com",
        "Port": 587,
        "Username": "YOUR_GMAIL_USERNAME",
        "Password": "YOUR_GMAIL_APP_PASSWORD"
    },
    "Ozow": {
        "SiteCode": "YOUR_OZOW_SITE_CODE",
        "PrivateKey": "YOUR_OZOW_PRIVATE_KEY",
        "ApiKey": "YOUR_OZOW_API_KEY",
        "ApiBaseUrl": "https://api.ozow.com",
        "TestMode": true,
        "ConnectionTimeoutSeconds": 30,
        "DefaultNotifyUrl": "YOUR_NOTIFY_URL"
    }
}