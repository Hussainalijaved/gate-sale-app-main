    private async Task OpenCamera()
    {
        if (selectedFiles.Count < 5)
        {
            try
            {
                Console.WriteLine("Opening Android camera...");
                await JSRuntime.InvokeVoidAsync("openAndroidCamera", cameraInput, DotNetObjectReference.Create(this));
            }
            catch (Exception ex)
            {
                Console.WriteLine($"Error opening camera: {ex.Message}");
            }
        }
        else
        {
            Console.WriteLine("Maximum number of files (5) already selected");
        }
    }

    private async Task OpenGallery()
    {
        if (selectedFiles.Count < 5)
        {
            try
            {
                Console.WriteLine("Opening gallery...");
                await JSRuntime.InvokeVoidAsync("triggerFileInput", galleryInput, DotNetObjectReference.Create(this));
            }
            catch (Exception ex)
            {
                Console.WriteLine($"Error opening gallery: {ex.Message}");
            }
        }
        else
        {
            Console.WriteLine("Maximum number of files (5) already selected");
        }
    }



    [JSInvokable]
    public void AddFileFromJS(string fileName, string base64Data, long fileSize, string contentType)
    {
        Console.WriteLine($"AddFileFromJS called: fileName={fileName}, fileSize={fileSize}, contentType={contentType}, selectedFiles.Count={selectedFiles.Count}");

        if (selectedFiles.Count < 5 && !string.IsNullOrEmpty(base64Data))
        {
            var mediaFile = new MediaFile
            {
                Name = fileName,
                PreviewUrl = $"data:{contentType};base64,{base64Data}",
                Base64Data = base64Data,
                Size = fileSize,
                ContentType = contentType
            };

            selectedFiles.Add(mediaFile);
            Console.WriteLine($"File added successfully. Total files: {selectedFiles.Count}");
            StateHasChanged();
        }
        else
        {
            Console.WriteLine($"File not added. Reason: selectedFiles.Count={selectedFiles.Count}, base64Data.IsEmpty={string.IsNullOrEmpty(base64Data)}");
        }
    }



    private async Task AddMediaSlot(int index)
    {
        if (index >= selectedFiles.Count && selectedFiles.Count < 5)
        {
            // Open gallery by default when clicking empty slot
            await OpenGallery();
        }
    }

    private void RemoveMedia(int index)
    {
        Console.WriteLine($"RemoveMedia called with index: {index}, selectedFiles.Count: {selectedFiles.Count}");

        if (selectedFiles != null && index >= 0 && index < selectedFiles.Count)
        {
            var removedFile = selectedFiles[index];
            selectedFiles.RemoveAt(index);
            Console.WriteLine($"Successfully removed file: {removedFile.Name}, remaining files: {selectedFiles.Count}");
            StateHasChanged();
        }
        else
        {
            Console.WriteLine($"Invalid removal attempt - index: {index}, selectedFiles.Count: {selectedFiles?.Count ?? 0}");
        }
    }

    private void NextStep()
    {
        if (selectedFiles.Count > 0)
        {
            TransitionService.RequestTransition("/set-your-price", GateSale.Services.TransitionType.SlideLeft);
        }
    }

    private void GoNext()
    {
        if (selectedFiles.Count > 0)
        {
            // Save photos to ProductCreationService
            ProductCreationService.SetPhotos(selectedFiles);
            TransitionService.RequestTransition("/buyers-help", GateSale.Services.TransitionType.SlideLeft);
        }
    }
}
