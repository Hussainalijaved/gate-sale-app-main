<script>
    window.triggerFileInput = (element, dotNetHelper) => {
        if (element) {
            const captureAttr = element.getAttribute('capture');
            const inputType = captureAttr ? `Camera` : 'Gallery';
            console.log('Triggering file input:', inputType);

            // Set up the change handler to process files
            element.onchange = async (event) => {
                console.log('Gallery input changed, processing files...');
                await window.processFileSelection(element, dotNetHelper);
            };

            element.click();
        } else {
            console.error('File input element not found');
        }
    };

    window.openAndroidCamera = async (element, dotNetHelper) => {
        if (element) {
            console.log('Opening Android camera...');

            // For Android devices, we need to be very explicit about camera access
            const isAndroid = /Android/i.test(navigator.userAgent);
            console.log('Is Android device:', isAndroid);

            // Create a completely fresh input element specifically for camera
            const cameraInput = document.createElement('input');
            cameraInput.type = 'file';
            cameraInput.accept = 'image/*';

            // For Android, use capture="environment" for rear camera
            cameraInput.setAttribute('capture', 'environment');

            // Ensure no multiple attribute (single photo only)
            cameraInput.removeAttribute('multiple');

            // Hide the input
            cameraInput.style.display = 'none';
            cameraInput.style.position = 'absolute';
            cameraInput.style.left = '-9999px';

            console.log('Camera input created with attributes:', {
                type: cameraInput.type,
                accept: cameraInput.accept,
                capture: cameraInput.getAttribute('capture'),
                multiple: cameraInput.getAttribute('multiple')
            });

            // Set up the change handler to process files
            cameraInput.onchange = async (event) => {
                console.log('Camera input changed, processing files...');
                await window.processFileSelection(cameraInput, dotNetHelper);
            };

            // Add to DOM
            document.body.appendChild(cameraInput);

            // For Android, add a small delay before triggering
            setTimeout(() => {
                console.log('Triggering camera input click...');
                cameraInput.click();
            }, 100);

            // Clean up after use
            setTimeout(() => {
                if (cameraInput.parentNode) {
                    console.log('Cleaning up camera input...');
                    document.body.removeChild(cameraInput);
                }
            }, 5000);

        } else {
            console.error('Camera input element not found');
        }
    };

    window.processFileSelection = async (inputElement, dotNetHelper) => {
        if (inputElement && inputElement.files && inputElement.files.length > 0) {
            console.log(`Processing ${inputElement.files.length} files...`);

            // Prevent double processing by checking if already processing
            if (inputElement.dataset.processing === 'true') {
                console.log('Already processing files, skipping...');
                return;
            }

            inputElement.dataset.processing = 'true';

            try {
                for (let i = 0; i < inputElement.files.length; i++) {
                    const file = inputElement.files[i];
                    console.log(`Processing file ${i + 1}/${inputElement.files.length}: ${file.name}`);

                    // Validate file type
                    if (!file.type.startsWith('image/')) {
                        alert('Please select only image files.');
                        continue;
                    }

                    // Validate file size (max 10MB)
                    if (file.size > 10 * 1024 * 1024) {
                        alert('File size must be less than 10MB.');
                        continue;
                    }

                    try {
                        // Convert file to base64
                        const base64 = await fileToBase64(file);
                        const base64Data = base64.split(',')[1]; // Remove data:image/...;base64, prefix

                        // Call Blazor method to add file
                        await dotNetHelper.invokeMethodAsync('AddFileFromJS',
                            file.name,
                            base64Data,
                            file.size,
                            file.type
                        );

                        console.log(`Successfully processed file: ${file.name}`);
                    } catch (error) {
                        console.error('Error processing file:', error);
                        alert('Error processing file: ' + file.name);
                    }
                }
            } finally {
                // Clear the input so the same file can be selected again
                inputElement.value = '';
                inputElement.dataset.processing = 'false';
                console.log('File processing completed');
            }
        }
    };

    function fileToBase64(file) {
        return new Promise((resolve, reject) => {
            const reader = new FileReader();
            reader.readAsDataURL(file);
            reader.onload = () => resolve(reader.result);
            reader.onerror = error => reject(error);
        });
    }


</script>

@code {
    private List<MediaFile> selectedFiles = new List<MediaFile>();
