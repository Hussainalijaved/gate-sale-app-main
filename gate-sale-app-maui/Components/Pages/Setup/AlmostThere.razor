@page "/almostthere"
@inject NavigationManager Navigation
@inject GateSale.Services.PageTransitionService TransitionService

<div class="almost-there-container">
    <!-- Header with back button and progress -->
    <div class="header-section">
        <button class="back-button" @onclick="GoBack">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none">
                <path d="M19 12H5" stroke="#000000" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
                <path d="M12 19L5 12L12 5" stroke="#000000" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
        </button>

    </div>

    <!-- Title section -->
    <div class="title-section">
        <h1 class="main-title">Almost There!</h1>
        <div class="celebration-emojis">🎉🚀</div>
    </div>

    <!-- Phone mockup with image -->
    <div class="email-card">
        <img src="/images/emailsent.png" alt="Email Sent" class="email-image" />
    </div>

    <!-- Description section -->
    <div class="description-section">
        <p class="description-text">
            We've sent an email to your parent.<br>
            As soon as they approve, you'll be<br>
            ready to start <span class="buying-text">buying</span> & <span class="selling-text">selling</span>!
        </p>
    </div>

    <!-- Buttons section -->
    <div class="buttons-section">
        <button class="window-shop-button" @onclick="WindowShop">
            <svg width="15" height="16" viewBox="0 0 15 16" fill="none" xmlns="http://www.w3.org/2000/svg">
<g clip-path="url(#clip0_2_764)">
<path d="M5.46875 3.5C5.46875 2.39687 6.36562 1.5 7.46875 1.5C8.57187 1.5 9.46875 2.39687 9.46875 3.5V5H5.46875V3.5ZM3.96875 5H1.96875C1.14062 5 0.46875 5.67188 0.46875 6.5V13C0.46875 14.6562 1.8125 16 3.46875 16H11.4688C13.125 16 14.4688 14.6562 14.4688 13V6.5C14.4688 5.67188 13.7969 5 12.9688 5H10.9688V3.5C10.9688 1.56562 9.40312 0 7.46875 0C5.53438 0 3.96875 1.56562 3.96875 3.5V5ZM4.71875 6.5C4.91766 6.5 5.10843 6.57902 5.24908 6.71967C5.38973 6.86032 5.46875 7.05109 5.46875 7.25C5.46875 7.44891 5.38973 7.63968 5.24908 7.78033C5.10843 7.92098 4.91766 8 4.71875 8C4.51984 8 4.32907 7.92098 4.18842 7.78033C4.04777 7.63968 3.96875 7.44891 3.96875 7.25C3.96875 7.05109 4.04777 6.86032 4.18842 6.71967C4.32907 6.57902 4.51984 6.5 4.71875 6.5ZM9.46875 7.25C9.46875 7.05109 9.54777 6.86032 9.68842 6.71967C9.82907 6.57902 10.0198 6.5 10.2188 6.5C10.4177 6.5 10.6084 6.57902 10.7491 6.71967C10.8897 6.86032 10.9688 7.05109 10.9688 7.25C10.9688 7.44891 10.8897 7.63968 10.7491 7.78033C10.6084 7.92098 10.4177 8 10.2188 8C10.0198 8 9.82907 7.92098 9.68842 7.78033C9.54777 7.63968 9.46875 7.44891 9.46875 7.25Z" fill="white"/>
</g>
<defs>
<clipPath id="clip0_2_764">
<path d="M0.46875 0H14.4688V16H0.46875V0Z" fill="white"/>
</clipPath>
</defs>
</svg>
 Window Shop While You Wait
        </button>

        <button class="back-home-button" @onclick="BackToHome">
            <svg width="19" height="16" viewBox="0 0 19 16" fill="none" xmlns="http://www.w3.org/2000/svg">
                <g clip-path="url(#clip0_2_770)">
                    <path d="M18.4937 7.98438C18.4937 8.54688 18.025 8.9875 17.4937 8.9875H16.4937L16.5156 13.9937C16.5156 14.0781 16.5094 14.1625 16.5 14.2469V14.75C16.5 15.4406 15.9406 16 15.25 16H14.75C14.7156 16 14.6813 16 14.6469 15.9969C14.6031 16 14.5594 16 14.5156 16H13.5H12.75C12.0594 16 11.5 15.4406 11.5 14.75V14V12C11.5 11.4469 11.0531 11 10.5 11H8.5C7.94688 11 7.5 11.4469 7.5 12V14V14.75C7.5 15.4406 6.94063 16 6.25 16H5.5H4.50313C4.45625 16 4.40937 15.9969 4.3625 15.9937C4.325 15.9969 4.2875 16 4.25 16H3.75C3.05938 16 2.5 15.4406 2.5 14.75V11.25C2.5 11.2219 2.5 11.1906 2.50312 11.1625V8.9875H1.5C0.9375 8.9875 0.5 8.55 0.5 7.98438C0.5 7.70312 0.59375 7.45312 0.8125 7.23438L8.825 0.25C9.04375 0.03125 9.29375 0 9.5125 0C9.73125 0 9.98125 0.0625 10.1687 0.21875L18.15 7.23438C18.4 7.45312 18.525 7.70312 18.4937 7.98438Z" fill="#374151" />
                </g>
                <defs>
                    <clipPath id="clip0_2_770">
                        <path d="M0.5 0H18.5V16H0.5V0Z" fill="white" />
                    </clipPath>
                </defs>
            </svg>
            Back to Home
        </button>
    </div>

    <!-- Footer section -->
    <div class="footer-section">
        <p class="help-text">
            Need help? <span class="contact-link" @onclick="ContactSupport">Contact Support</span>
        </p>
    </div>
</div>

<style>
    .almost-there-container {
        display: flex;
        flex-direction: column;
        padding: 0;
        font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
        background-color: #F9FAFB;
        height: 100vh;
        max-width: 375px;
        width: 100%;
        margin: 0 auto;
        position: relative;
        overflow: hidden;
    }

    .header-section {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 12px 20px;
        margin-top: 5px;
        flex-shrink: 0;
    }

    .back-button {
        background: none;
        border: none;
        padding: 8px;
        cursor: pointer;
        border-radius: 8px;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    
    

    .title-section {
        text-align: center;
        margin: 10px 0 5px 0;
        flex-shrink: 0;
    }

    .main-title {
        font-size: 28px;
        font-weight: 700;
        color: #111827;
        margin: 0 0 6px 0;
        line-height: 1.2;
    }

    .celebration-emojis {
        font-size: 20px;
    }
    .email-card {
        display: flex;
        justify-content: center;
        align-items: center;
        margin: 30px 0 30px 0;
    }

    .email-image {
        width: 300px;
        height: 300px;
        object-fit: contain;
        border-radius: 12px;
    }
    

    


    .description-section {
        text-align: center;
        margin: 10px 20px 10px 20px;
        flex-shrink: 0;
    }

    .description-text {
        font-size: 15px;
        color: #666666;
        line-height: 1.4;
        margin: 0;
    }

    .buying-text {
        color: #10B981;
        font-weight: 600;
    }

    .selling-text {
        color: #EF4444;
        font-weight: 600;
    }

    .buttons-section {
        padding: 0 20px;
        display: flex;
        flex-direction: column;
        gap: 10px;
        margin-bottom: 5px;
        flex-shrink: 0;
    }

    .window-shop-button {
        width: 100%;
        height: 55px;
        background-color: #00BFFF;
        color: white;
        border: none;
        border-radius: 15px;
        font-size: 15px;
        font-weight: 600;
        cursor: pointer;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        box-shadow: 0 3px 8px rgba(59, 130, 246, 0.3);
    }

    

    .back-home-button {
        width: 100%;
        height: 55px;
        background-color: white;
        color: #666666;
        border: 1px solid #E5E7EB;
        border-radius: 15px;
        font-size: 15px;
        font-weight: 600;
        cursor: pointer;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
    }

  

    .footer-section {
        text-align: center;
        padding: 10px 5px 20px 5px;
        flex-shrink: 0;
    }

    .help-text {
        font-size: 13px;
        color: #9CA3AF;
        margin: 0;
    }

    .contact-link {
        color: #3ABEF9;
        cursor: pointer;
        text-decoration: none;
    }

    .contact-link:hover {
        text-decoration: underline;
    }
</style>

@code {
    private void GoBack()
    {
        TransitionService.RequestTransition("/parentalconsent", GateSale.Services.TransitionType.SlideRight);
    }

    private void WindowShop()
    {
        TransitionService.RequestTransition("/home2", GateSale.Services.TransitionType.SlideLeft);
    }

    private void BackToHome()
    {
        TransitionService.RequestTransition("/login", GateSale.Services.TransitionType.Fade);
    }

    private void ContactSupport()
    {
        // Implement contact support logic
    }
}
