    <!-- Content section -->
    <div class="content-section">
        <h1 class="main-title">Check Your Inbox</h1>
        <p class="description">
            We've sent you a verification email.<br>
            Please check your inbox and click the<br>
            link to verify your account.
        </p>
    </div>

    <!-- Button section -->
    <div class="button-section">
        <button class="email-client-button" @onclick="OpenEmailClient">
            Resend Email
        </button>
    </div>

    <!-- Footer section -->
    <div class="footer-section">
        <p class="footer-text">
            Didn't receive the email? Check your spam folder
        </p>
    </div>
</div>

<style>
    .check-inbox-container {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        padding: 60px 20px;
        font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
        background-color: #FFFFFF;
        min-height: 100vh;
        max-width: 375px;
        width: 100%;
        margin: 0 auto;
        gap: 0;
    }

    .illustration-section {
        margin-bottom: 40px;
        display: flex;
        justify-content: center;
    }

    .mailbox-image {
        width: 200px;
        height: 160px;
        object-fit: contain;
    }

    .content-section {
        text-align: center;
        margin-bottom: 32px;
    }

    .main-title {
        font-size: 24px;
        font-weight: 700;
        color: #111827;
        margin: 0 0 20px 0;
        line-height: 1.2;
    }

    .description {
        font-size: 16px;
        color: #666666;
        line-height: 1.5;
        margin: 0;
    }

    .button-section {
        width: 100%;
        max-width: 320px;
        margin-bottom: 24px;
    }

    .email-client-button {
        width: 100%;
        height: 50px;
        background-color: #00BFFF;
        color: white;
        border: none;
        border-radius: 15px;
        font-size: 16px;
        font-weight: 600;
        cursor: pointer;
        transition: all 0.2s ease;
        box-shadow: 0 3px 6px rgba(0, 191, 255, 0.3);
    }

    .email-client-button:hover {
        background-color: #0099CC;
        box-shadow: 0 4px 8px rgba(0, 191, 255, 0.4);
    }

        

    .footer-section {
        margin-top: 16px;
        padding-top: 0;
    }

    .footer-text {
        font-size: 14px;
        color: #999999;
        text-align: center;
        margin: 0;
        line-height: 1.4;
        max-width: 280px;
    }
</style>

@code {
    private void OpenEmailClient()
    {
        TransitionService.RequestTransition("/parentalconsent", GateSale.Services.TransitionType.SlideLeft);
    }
}
