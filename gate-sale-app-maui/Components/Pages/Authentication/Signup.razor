@page "/signup"
@inject NavigationManager Navigation
@inject GateSale.Services.PageTransitionService TransitionService

<div class="signup-container">
    <!-- Header -->
    <div class="header-section">
        <h1 class="main-title">Let's Get You Started</h1>
        <p class="subtitle">Create your student account in just a few steps</p>
    </div>

    <!-- Illustration -->
    <div class="illustration-section">
        <div class="illustration-circle">
            <img src="/images/bagpack.jpg" alt="Backpack Logo" class="logo-image" />
        </div>
    </div>

    <!-- Form -->
    <div class="form-section">
        <!-- Name Fields -->
        <div class="name-row">
            <div class="input-group">
                <label class="input-label">First Name</label>
                <input type="text" class="form-input" placeholder="Enter first name" @bind="firstName" />
            </div>
            <div class="input-group">
                <label class="input-label">Last Name</label>
                <input type="text" class="form-input" placeholder="Enter last name" @bind="lastName" />
            </div>
        </div>

        <!-- Email Field -->
        <div class="input-group">
            <label class="input-label">School Email Address</label>
            <div class="input-with-icon">
                <svg class="input-icon" width="16" height="16" viewBox="0 0 24 24" fill="none">
                    <path d="M20 4H4C2.9 4 2.01 4.9 2.01 6L2 18C2 19.1 2.9 20 4 20H20C21.1 20 22 19.1 22 18V6C22 4.9 21.1 4 20 4ZM20 8L12 13L4 8V6L12 11L20 6V8Z" fill="#9CA3AF"/>
                </svg>
                <input type="email" class="form-input with-icon" placeholder="your.email@school.edu" @bind="email" />
            </div>
        </div>

        <!-- School Field -->
        <div class="input-group">
            <label class="input-label">School</label>
            <div class="input-with-icon">
                <svg class="input-icon" width="16" height="16" viewBox="0 0 24 24" fill="none">
                    <path d="M12 3L1 9L12 15L21 10.09V17H23V9M5 13.18V17.18L12 21L19 17.18V13.18L12 17L5 13.18Z" fill="#9CA3AF"/>
                </svg>
                <input type="text" class="form-input with-icon" placeholder="Enter your school name" 
                       value="@school" @oninput="OnSchoolInput" />
            </div>
            @if (isCheckingSchool)
            {
                <p class="input-info">Checking school support...</p>
            }
            else if (isSchoolFound)
            {
                @if (isSchoolPending)
                {
                    <p class="input-info">This school is being reviewed. You can still register!</p>
                }
                else
                {
                    <p class="input-success">School already supported!</p>
                }
            }
            else if (!string.IsNullOrWhiteSpace(school) && school.Length >= 3)
            {
                <p class="input-warning">School not found. You'll be asked to add it.</p>
            }
        </div>

        <!-- Date of Birth Field -->
        <div class="input-group">
            <label class="input-label">Date of Birth</label>
            <div class="input-with-icon">
                <svg class="input-icon" width="16" height="16" viewBox="0 0 24 24" fill="none">
                    <path d="M19 4H18V2H16V4H8V2H6V4H5C3.89 4 3.01 4.9 3.01 6L3 20C3 21.1 3.89 22 5 22H19C20.1 22 21 21.1 21 20V6C21 4.9 20.1 4 19 4ZM19 20H5V10H19V20ZM19 8H5V6H19V8Z" fill="#9CA3AF"/>
                </svg>
                <input type="date" class="form-input with-icon" @bind="dateOfBirth" />
            </div>
        </div>

                 <!-- Grade Field -->
 <div class="input-group">
     <label class="input-label">Grade</label>
     <div class="input-with-icon">
         <svg class="input-icon" width="16" height="16" viewBox="0 0 24 24" fill="none">
             <path d="M12 3L1 9L12 15L21 10.09V17H23V9M5 13.18V17.18L12 21L19 17.18V13.18L12 17L5 13.18Z" fill="#9CA3AF"/>
         </svg>
         <select class="form-select with-icon" @bind="selectedGrade">
             <option value="" disabled>Select your grade</option>
             <option value="8">Grade 8</option>
             <option value="9">Grade 9</option>
             <option value="10">Grade 10</option>
             <option value="11">Grade 11</option>
             <option value="12">Grade 12</option>
         </select>
         <svg class="dropdown-arrow" width="16" height="16" viewBox="0 0 24 24" fill="none">
             <path d="M7 10L12 15L17 10H7Z" fill="#9CA3AF"/>
         </svg>
     </div>
 </div>

        <!-- Parent Email Field (Conditional) -->
        @if (selectedGrade == "8" || selectedGrade == "9")
        {
            <div class="input-group">
                <label class="input-label">Parent Email Address</label>
                <div class="input-with-icon">
                    <svg class="input-icon" width="16" height="16" viewBox="0 0 24 24" fill="none">
                        <path d="M20 4H4C2.9 4 2.01 4.9 2.01 6L2 18C2 19.1 2.9 20 4 20H20C21.1 20 22 19.1 22 18V6C22 4.9 21.1 4 20 4ZM20 8L12 13L4 8V6L12 11L20 6V8Z" fill="#9CA3AF"/>
                    </svg>
                    <input type="email" class="form-input with-icon" placeholder="parent.email@example.com" @bind="parentEmail" />
                </div>
                <p class="input-hint">Required for students in Grade 8 and 9.</p>
            </div>
        }

        <!-- Password Field -->
        <div class="input-group">
            <label class="input-label">Password</label>
            <div class="input-with-icon">
                <svg class="input-icon-left" width="16" height="16" viewBox="0 0 24 24" fill="none">
                    <path d="M12 17C10.89 17 10 16.1 10 15C10 13.89 10.89 13 12 13C13.11 13 14 13.89 14 15C14 16.1 13.11 17 12 17ZM18 8C19.1 8 20 8.9 20 10V20C20 21.1 19.1 22 18 22H6C4.9 22 4 21.1 4 20V10C4 8.9 4.9 8 6 8H7V6C7 3.24 9.24 1 12 1C14.76 1 17 3.24 17 6V8H18ZM12 3C10.34 3 9 4.34 9 6V8H15V6C15 4.34 13.66 3 12 3Z" fill="#9CA3AF"/>
                </svg>
                <input type="@(showPassword ? "text" : "password")" class="form-input with-icon-both" placeholder="Create a password" @bind="password" />
                <button type="button" class="eye-button" @onclick="TogglePasswordVisibility">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none">
                        <path d="M12 4.5C7 4.5 2.73 7.61 1 12C2.73 16.39 7 19.5 12 19.5S21.27 16.39 23 12C21.27 7.61 17 4.5 12 4.5ZM12 17C9.24 17 7 14.76 7 12S9.24 7 12 7S17 9.24 17 12S14.76 17 12 17ZM12 9C10.34 9 9 10.34 9 12S10.34 15 12 15S15 13.66 15 12S13.66 9 12 9Z" fill="#9CA3AF"/>
                    </svg>
                </button>
            </div>
        </div>

        <!-- Confirm Password Field -->
        <div class="input-group">
            <label class="input-label">Confirm Password</label>
            <div class="input-with-icon">
                <svg class="input-icon-left" width="16" height="16" viewBox="0 0 24 24" fill="none">
                    <path d="M12 17C10.89 17 10 16.1 10 15C10 13.89 10.89 13 12 13C13.11 13 14 13.89 14 15C14 16.1 13.11 17 12 17ZM18 8C19.1 8 20 8.9 20 10V20C20 21.1 19.1 22 18 22H6C4.9 22 4 21.1 4 20V10C4 8.9 4.9 8 6 8H7V6C7 3.24 9.24 1 12 1C14.76 1 17 3.24 17 6V8H18ZM12 3C10.34 3 9 4.34 9 6V8H15V6C15 4.34 13.66 3 12 3Z" fill="#9CA3AF"/>
                </svg>
                <input type="@(showConfirmPassword ? "text" : "password")" class="form-input with-icon-both" placeholder="Confirm your password" @bind="confirmPassword" />
                <button type="button" class="eye-button" @onclick="ToggleConfirmPasswordVisibility">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none">
                        <path d="M12 4.5C7 4.5 2.73 7.61 1 12C2.73 16.39 7 19.5 12 19.5S21.27 16.39 23 12C21.27 7.61 17 4.5 12 4.5ZM12 17C9.24 17 7 14.76 7 12S9.24 7 12 7S17 9.24 17 12S14.76 17 12 17ZM12 9C10.34 9 9 10.34 9 12S10.34 15 12 15S15 13.66 15 12S13.66 9 12 9Z" fill="#9CA3AF"/>
                    </svg>
                </button>
            </div>
        </div>

        <!-- Terms Checkbox -->
        <div class="checkbox-group">
            <label class="checkbox-label">
                <input type="checkbox" class="checkbox-input" @bind="agreeToTerms" />
                <span class="checkbox-custom"></span>
                <span class="checkbox-text">I am a student and agree to the <a href="#" class="terms-link">Terms of Use</a></span>
            </label>
        </div>

        <!-- Error Message -->
        @if (!string.IsNullOrEmpty(errorMessage))
        {
            <div class="error-message">@errorMessage</div>
        }

        <!-- Next Button -->
        <button class="btn-base btn-primary btn-next-compact with-icon" @onclick="HandleSignup" disabled="@isProcessing">
            @if (isProcessing)
            {
                <span>Processing...</span>
            }
            else
            {
                <span>Next</span>
                <svg width="13" height="11" viewBox="0 0 13 11" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <path d="M12.3211 6.3699C12.6629 6.0281 12.6629 5.47302 12.3211 5.13123L7.94609 0.756226C7.6043 0.414429 7.04922 0.414429 6.70742 0.756226C6.36562 1.09802 6.36562 1.6531 6.70742 1.9949L9.59219 4.87693H1.20312C0.719141 4.87693 0.328125 5.26794 0.328125 5.75193C0.328125 6.23591 0.719141 6.62693 1.20312 6.62693H9.58945L6.71016 9.50896C6.36836 9.85076 6.36836 10.4058 6.71016 10.7476C7.05195 11.0894 7.60703 11.0894 7.94883 10.7476L12.3238 6.37263L12.3211 6.3699Z" fill="white" />
                </svg>
            }
        </button>

        <!-- Sign In Link -->
        <p class="signin-text">
            Already have an account? <button type="button" class="signin-link" @onclick="GoToSignIn">Sign in</button>
        </p>
    </div>
</div>

<style>
