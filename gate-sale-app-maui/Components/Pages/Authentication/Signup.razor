@code {
    [Inject] private GateSale.Services.Interfaces.IUserService UserService { get; set; } = default!;
    [Inject] private GateSale.Services.Interfaces.ISchoolService SchoolService { get; set; } = default!;

    private string firstName = "";
    private string lastName = "";
    private string email = "";
    private string parentEmail = "";
    private string school = "";
    private DateTime dateOfBirth = DateTime.Today.AddYears(-15);
    private string selectedGrade = "";
    private string password = "";
    private string confirmPassword = "";
    private bool agreeToTerms = false;
    private bool showPassword = false;
    private bool showConfirmPassword = false;
    private bool isProcessing = false;
    private string errorMessage = "";
    private bool isSchoolFound = false;
    private bool isSchoolPending = false;
    private bool isCheckingSchool = false;
    private System.Threading.Timer? schoolCheckTimer;

    [Parameter]
    [SupplyParameterFromQuery]
    public string? Email { get; set; }

    [Parameter]
    [SupplyParameterFromQuery]
    public string? SchoolName { get; set; }

    protected override void OnInitialized()
    {
        if (!string.IsNullOrEmpty(Email)) email = Email;
        if (!string.IsNullOrEmpty(SchoolName)) 
        {
            school = SchoolName;
            _ = CheckSchoolAsync(school);
        }
    }

    private void OnSchoolInput(ChangeEventArgs e)
    {
        school = e.Value?.ToString() ?? "";
        isSchoolFound = false;

        schoolCheckTimer?.Dispose();
        schoolCheckTimer = new System.Threading.Timer(async _ =>
        {
            await InvokeAsync(async () =>
            {
                await CheckSchoolAsync(school);
            });
        }, null, 800, System.Threading.Timeout.Infinite);
    }

    private async Task CheckSchoolAsync(string name)
    {
        if (string.IsNullOrWhiteSpace(name) || name.Length < 3)
        {
            isSchoolFound = false;
            isCheckingSchool = false;
            StateHasChanged();
            return;
        }

        isCheckingSchool = true;
        StateHasChanged();

        try
        {
            var existingSchool = await SchoolService.GetSchoolByNameAsync(name);
            isSchoolFound = existingSchool != null;
            isSchoolPending = existingSchool?.IsPending ?? false;
        }
        finally
        {
            isCheckingSchool = false;
            StateHasChanged();
        }
    }

    private void TogglePasswordVisibility()
    {
        showPassword = !showPassword;
    }

    private void ToggleConfirmPasswordVisibility()
    {
        showConfirmPassword = !showConfirmPassword;
    }

    private bool IsFormValid()
    {
        return !string.IsNullOrWhiteSpace(firstName) &&
               !string.IsNullOrWhiteSpace(lastName) &&
               !string.IsNullOrWhiteSpace(email) &&
               !string.IsNullOrWhiteSpace(school) &&
               !string.IsNullOrWhiteSpace(selectedGrade) &&
               !string.IsNullOrWhiteSpace(password) &&
               !string.IsNullOrWhiteSpace(confirmPassword) &&
               password == confirmPassword &&
               agreeToTerms &&
               ((selectedGrade != "8" && selectedGrade != "9") || !string.IsNullOrWhiteSpace(parentEmail));
    }

    private async Task HandleSignup()
    {
        if (!IsFormValid())
        {
            errorMessage = "Please fill in all fields correctly.";
            return;
        }

        isProcessing = true;
        errorMessage = "";

        try
        {
            // Check if school exists
            var existingSchool = await SchoolService.GetSchoolByNameAsync(school);
            if (existingSchool == null)
            {
                // School not found, redirect to Add School page with all registration data
                var queryParams = new Dictionary<string, string?>
                {
                    ["email"] = email,
                    ["schoolName"] = school,
                    ["firstName"] = firstName,
                    ["lastName"] = lastName,
                    ["password"] = password,
                    ["selectedGrade"] = selectedGrade,
                    ["dateOfBirth"] = dateOfBirth.ToString("yyyy-MM-dd"),
                    ["parentEmail"] = parentEmail
                };
                var queryString = string.Join("&", queryParams.Select(p => $"{p.Key}={Uri.EscapeDataString(p.Value ?? "")}"));
                TransitionService.RequestTransition($"/addschool?{queryString}", GateSale.Services.TransitionType.SlideLeft);
                return;
            }

            var user = new GateSale.Models.User
            {
                FirstName = firstName,
                LastName = lastName,
                Email = email,
                SchoolId = existingSchool.Id,
                Grade = selectedGrade,
                DateOfBirth = dateOfBirth,
                PhoneNumber = parentEmail // Using PhoneNumber field temporarily to pass ParentEmail to UserService
            };

            var result = await UserService.RegisterUserAsync(user, password);

            if (result.Success)
            {
                // Navigate to verification page
                TransitionService.RequestTransition($"/verification-code?email={email}&mode=register&parentEmail={Uri.EscapeDataString(parentEmail)}", GateSale.Services.TransitionType.SlideLeft);
            }
            else
            {
                errorMessage = result.Message;
            }
        }
        catch (Exception ex)
        {
            errorMessage = "An unexpected error occurred. Please try again.";
        }
        finally
        {
            isProcessing = false;
        }
    }

    private void GoToSignIn()
    {
        // Navigate to login page
        TransitionService.RequestTransition("/login", GateSale.Services.TransitionType.SlideRight);
    }
}
