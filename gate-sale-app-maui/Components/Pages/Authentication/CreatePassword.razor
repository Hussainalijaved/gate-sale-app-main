@page "/create-password"
@inject NavigationManager Navigation
@inject GateSale.Services.PageTransitionService TransitionService

<div class="create-password-container">
    <!-- Back Button -->
    <button class="back-button" @onclick="GoBack">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none">
            <path d="M19 12H5M12 19L5 12L12 5" stroke="#6B7280" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
    </button>

    <!-- Main Content -->
    <div class="content-section">
        <!-- Icon -->
        <div class="icon-section">
            <div class="icon-circle">
                <svg width="22" height="24" viewBox="0 0 22 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <path d="M7.25 6.75V9H14.75V6.75C14.75 4.67812 13.0719 3 11 3C8.92813 3 7.25 4.67812 7.25 6.75ZM4.25 9V6.75C4.25 3.02344 7.27344 0 11 0C14.7266 0 17.75 3.02344 17.75 6.75V9H18.5C20.1547 9 21.5 10.3453 21.5 12V21C21.5 22.6547 20.1547 24 18.5 24H3.5C1.84531 24 0.5 22.6547 0.5 21V12C0.5 10.3453 1.84531 9 3.5 9H4.25Z" fill="white"/>
                </svg>
            </div>
        </div>

        <!-- Title and Description -->
        <div class="text-section">
            <h1 class="main-title">Create New Password</h1>
            <p class="description">Your new password must be different from your previous password</p>
        </div>

        <!-- Password Inputs -->
        <div class="password-section">
            <!-- New Password -->
            <div class="input-group">
                <label class="input-label">New Password</label>
                <div class="input-wrapper">
                                         <input type="@(showNewPassword ? "text" : "password")" 
                            class="form-input" 
                            placeholder="Enter new password" 
                            @bind="newPassword"
                            @bind:event="oninput" />
                                         <button type="button" class="password-toggle" @onclick="ToggleNewPasswordVisibility">
                         @if (showNewPassword)
                         {
                             <svg width="20" height="20" viewBox="0 0 24 24" fill="none">
                                 <path d="M17.94 17.94C16.2306 19.243 14.1491 19.9649 12 20C5 20 1 12 1 12C2.24389 9.68192 4.02811 7.65663 6.17 6.17M9.9 4.24C10.5883 4.0789 11.2931 3.99836 12 4C19 4 23 12 23 12C22.393 13.1356 21.6691 14.2048 20.84 15.19M14.12 14.12C13.8454 14.4148 13.5141 14.6512 13.1462 14.8151C12.7782 14.9791 12.3809 15.0673 11.9781 15.0744C11.5753 15.0815 11.1749 15.0074 10.8016 14.8565C10.4282 14.7056 10.0887 14.4811 9.80385 14.1962C9.51897 13.9113 9.29439 13.5718 9.14351 13.1984C8.99262 12.8251 8.91853 12.4247 8.92563 12.0219C8.93274 11.6191 9.02091 11.2218 9.18488 10.8538C9.34884 10.4858 9.58525 10.1546 9.88 9.88" stroke="#374151" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                                 <path d="M1 1L23 23" stroke="#374151" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                             </svg>
                         }
                         else
                         {
                             <svg width="20" height="20" viewBox="0 0 24 24" fill="none">
                                 <path d="M1 12S5 4 12 4S23 12 23 12S19 20 12 20S1 12 1 12Z" stroke="#9CA3AF" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                                 <circle cx="12" cy="12" r="3" stroke="#9CA3AF" stroke-width="2"/>
                             </svg>
                         }
                     </button>
                </div>
            </div>

            <!-- Confirm Password -->
            <div class="input-group">
                <label class="input-label">Confirm Password</label>
                <div class="input-wrapper">
                                         <input type="@(showConfirmPassword ? "text" : "password")" 
                            class="form-input" 
                            placeholder="Confirm new password" 
                            @bind="confirmPassword"
                            @bind:event="oninput" />
                                         <button type="button" class="password-toggle" @onclick="ToggleConfirmPasswordVisibility">
                         @if (showConfirmPassword)
                         {
                             <svg width="20" height="20" viewBox="0 0 24 24" fill="none">
                                 <path d="M17.94 17.94C16.2306 19.243 14.1491 19.9649 12 20C5 20 1 12 1 12C2.24389 9.68192 4.02811 7.65663 6.17 6.17M9.9 4.24C10.5883 4.0789 11.2931 3.99836 12 4C19 4 23 12 23 12C22.393 13.1356 21.6691 14.2048 20.84 15.19M14.12 14.12C13.8454 14.4148 13.5141 14.6512 13.1462 14.8151C12.7782 14.9791 12.3809 15.0673 11.9781 15.0744C11.5753 15.0815 11.1749 15.0074 10.8016 14.8565C10.4282 14.7056 10.0887 14.4811 9.80385 14.1962C9.51897 13.9113 9.29439 13.5718 9.14351 13.1984C8.99262 12.8251 8.91853 12.4247 8.92563 12.0219C8.93274 11.6191 9.02091 11.2218 9.18488 10.8538C9.34884 10.4858 9.58525 10.1546 9.88 9.88" stroke="#374151" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                                 <path d="M1 1L23 23" stroke="#374151" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                             </svg>
                         }
                         else
                         {
                             <svg width="20" height="20" viewBox="0 0 24 24" fill="none">
                                 <path d="M1 12S5 4 12 4S23 12 23 12S19 20 12 20S1 12 1 12Z" stroke="#9CA3AF" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                                 <circle cx="12" cy="12" r="3" stroke="#9CA3AF" stroke-width="2"/>
                             </svg>
                         }
                     </button>
                </div>
            </div>
        </div>

        <!-- Password Requirements -->
        <div class="requirements-section">
            <h3 class="requirements-title">Password must contain:</h3>
            <div class="requirements-list">
                <div class="requirement-item @(HasMinLength() ? "met" : "")">
                    <svg class="requirement-icon" width="16" height="16" viewBox="0 0 24 24" fill="none">
                        @if (HasMinLength())
                        {
                            <path d="M20 6L9 17L4 12" stroke="#10B981" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                        }
                        else
                        {
                            <circle cx="12" cy="12" r="10" stroke="#9CA3AF" stroke-width="2"/>
                        }
                    </svg>
                    <span class="requirement-text">At least 8 characters</span>
                </div>
                <div class="requirement-item @(HasUppercase() ? "met" : "")">
                    <svg class="requirement-icon" width="16" height="16" viewBox="0 0 24 24" fill="none">
                        @if (HasUppercase())
                        {
                            <path d="M20 6L9 17L4 12" stroke="#10B981" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                        }
                        else
                        {
                            <circle cx="12" cy="12" r="10" stroke="#9CA3AF" stroke-width="2"/>
                        }
                    </svg>
                    <span class="requirement-text">One uppercase letter</span>
                </div>
                <div class="requirement-item @(HasNumber() ? "met" : "")">
                    <svg class="requirement-icon" width="16" height="16" viewBox="0 0 24 24" fill="none">
                        @if (HasNumber())
                        {
                            <path d="M20 6L9 17L4 12" stroke="#10B981" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                        }
                        else
                        {
                            <circle cx="12" cy="12" r="10" stroke="#9CA3AF" stroke-width="2"/>
                        }
                    </svg>
                    <span class="requirement-text">One number</span>
                </div>
                <div class="requirement-item @(HasSpecialChar() ? "met" : "")">
                    <svg class="requirement-icon" width="16" height="16" viewBox="0 0 24 24" fill="none">
                        @if (HasSpecialChar())
                        {
                            <path d="M20 6L9 17L4 12" stroke="#10B981" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                        }
                        else
                        {
                            <circle cx="12" cy="12" r="10" stroke="#9CA3AF" stroke-width="2"/>
                        }
                    </svg>
                    <span class="requirement-text">One special character</span>
                </div>
            </div>
        </div>

                 <!-- Create Password Button -->
         <button class="btn-create @(IsFormValid() ? "active" : "disabled")" @onclick="HandleCreatePassword" disabled="@(!IsFormValid())">
             Create Password
         </button>
    </div>
</div>

<style>
    .create-password-container {
        display: flex;
        flex-direction: column;
        min-height: 100vh;
        background: linear-gradient(90deg, #FFFFFF 0%, #F8FCFF 40%, #F0F8FF 70%, #E8F4FD 100%);
        font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
        position: relative;
    }

    .back-button {
        position: absolute;
        top: 20px;
        left: 20px;
        width: 40px;
        height: 40px;
        border-radius: 50%;
        background: #F3F4F6;
        border: none;
        display: flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        z-index: 10;
        transition: background-color 0.2s ease;
    }

    .back-button:hover {
        background: #E5E7EB;
    }

    .content-section {
        flex: 1;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        padding: 80px 24px 24px 24px;
        max-width: 400px;
        margin: 0 auto;
        width: 100%;
    }

    .icon-section {
        margin-bottom: 32px;
    }

    .icon-circle {
        width: 80px;
        height: 80px;
        background: linear-gradient(135deg, #3ABEF9 0%, #10B981 100%);
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .text-section {
        text-align: center;
        margin-bottom: 32px;
    }

    .main-title {
        font-size: 28px;
        font-weight: 700;
        color: #1F2937;
        margin: 0 0 12px 0;
        line-height: 1.2;
    }

    .description {
        font-size: 16px;
        color: #6B7280;
        margin: 0;
        line-height: 1.5;
    }

    .password-section {
        width: 100%;
        margin-bottom: 24px;
    }

    .input-group {
        margin-bottom: 20px;
    }

    .input-label {
        font-size: 14px;
        font-weight: 600;
        color: #374151;
        margin-bottom: 8px;
        display: block;
    }

    .input-wrapper {
        position: relative;
        display: flex;
        align-items: center;
    }

    .form-input {
        width: 100%;
        height: 48px;
        padding: 12px 48px 12px 16px;
        border: 1px solid #D1D5DB;
        border-radius: 12px;
        font-size: 16px;
        color: #1F2937;
        background-color: #F9FAFB;
        box-sizing: border-box;
        transition: all 0.2s ease;
    }

    .form-input:focus {
        outline: none;
        border-color: #3ABEF9;
        box-shadow: 0 0 0 3px rgba(58, 190, 249, 0.1);
        background-color: #FFFFFF;
    }

    .form-input::placeholder {
        color: #9CA3AF;
    }

         .password-toggle {
         position: absolute;
         right: 16px;
         background: none;
         border: none;
         cursor: pointer;
         padding: 0;
         display: flex;
         align-items: center;
         justify-content: center;
         z-index: 2;
         width: 20px;
         height: 20px;
     }

         .password-toggle:hover {
         opacity: 0.7;
     }

     .password-toggle svg {
         width: 20px;
         height: 20px;
         flex-shrink: 0;
     }

    .requirements-section {
        width: 100%;
        margin-bottom: 24px;
    }

    .requirements-title {
        font-size: 14px;
        font-weight: 600;
        color: #374151;
        margin: 0 0 12px 0;
    }

    .requirements-list {
        display: flex;
        flex-direction: column;
        gap: 8px;
    }

    .requirement-item {
        display: flex;
        align-items: center;
        gap: 8px;
        transition: color 0.2s ease;
    }

    .requirement-item.met {
        color: #10B981;
    }

    .requirement-item:not(.met) {
        color: #6B7280;
    }

    .requirement-icon {
        flex-shrink: 0;
    }

    .requirement-text {
        font-size: 13px;
    }

    .btn-create {
        width: 100%;
        height: 48px;
        border: none;
        border-radius: 12px;
        font-size: 16px;
        font-weight: 600;
        cursor: pointer;
        transition: all 0.2s ease;
    }

    .btn-create.active {
        background: #3ABEF9;
        color: white;
    }

    .btn-create.active:hover {
        background: #2AA8E5;
    }

         .btn-create.disabled {
         background: #E5E7EB;
         color: #9CA3AF;
         cursor: not-allowed;
     }
</style>

@code {
    private string newPassword = "";
    private string confirmPassword = "";
    private bool showNewPassword = false;
    private bool showConfirmPassword = false;

    private void ToggleNewPasswordVisibility()
    {
        showNewPassword = !showNewPassword;
    }

    private void ToggleConfirmPasswordVisibility()
    {
        showConfirmPassword = !showConfirmPassword;
    }

    private bool HasMinLength()
    {
        return newPassword.Length >= 8;
    }

    private bool HasUppercase()
    {
        return newPassword.Any(char.IsUpper);
    }

    private bool HasNumber()
    {
        return newPassword.Any(char.IsDigit);
    }

    private bool HasSpecialChar()
    {
        return newPassword.Any(c => !char.IsLetterOrDigit(c));
    }



    private bool PasswordsMatch()
    {
        return !string.IsNullOrEmpty(newPassword) && 
               !string.IsNullOrEmpty(confirmPassword) && 
               newPassword == confirmPassword;
    }

    private bool IsFormValid()
    {
        return HasMinLength() && 
               HasUppercase() && 
               HasNumber() && 
               HasSpecialChar() && 
               PasswordsMatch();
    }

    private void GoBack()
    {
        TransitionService.RequestTransition("/verification-code", GateSale.Services.TransitionType.SlideRight);
    }

    private void HandleCreatePassword()
    {
        if (IsFormValid())
        {
            // Here you would call your API to update the password
            // For now, navigate to success screen
            TransitionService.RequestTransition("/password-success", GateSale.Services.TransitionType.SlideLeft);
        }
    }
}
