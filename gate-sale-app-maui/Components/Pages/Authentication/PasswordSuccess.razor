@page "/password-success"
@inject NavigationManager Navigation
@inject GateSale.Services.PageTransitionService TransitionService

<div class="success-container">
    <!-- Back Button -->
    <button class="back-button" @onclick="GoBack">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none">
            <path d="M19 12H5M12 19L5 12L12 5" stroke="#6B7280" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
    </button>

    <!-- Main Content -->
    <div class="content-section">
        <!-- Icon -->
        <div class="icon-section">
            <div class="icon-circle">
                <svg width="27" height="19" viewBox="0 0 27 19" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <path d="M25.7036 0.549316C26.436 1.28174 26.436 2.47119 25.7036 3.20361L10.7036 18.2036C9.97119 18.936 8.78174 18.936 8.04932 18.2036L0.549316 10.7036C-0.183105 9.97119 -0.183105 8.78174 0.549316 8.04932C1.28174 7.3169 2.47119 7.3169 3.20361 8.04932L9.37939 14.2192L23.0552 0.549316C23.7876 -0.183105 24.9771 -0.183105 25.7095 0.549316H25.7036Z" fill="white"/>
                </svg>
            </div>
        </div>

        <!-- Title and Description -->
        <div class="text-section">
            <h1 class="main-title">Password Changed Successfully!</h1>
            <p class="description">Your password has been updated successfully. You can now use your new password to sign in to your account.</p>
        </div>

        <!-- Security Tip -->
        <div class="security-tip">
            <div class="tip-icon">
                <svg width="14" height="15" viewBox="0 0 14 15" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <path d="M7.00001 0.75C7.12579 0.75 7.25157 0.777344 7.36642 0.829297L12.5152 3.01406C13.1168 3.26836 13.5652 3.86172 13.5625 4.57812C13.5488 7.29063 12.4332 12.2535 7.72189 14.5094C7.26525 14.7281 6.73478 14.7281 6.27814 14.5094C1.56681 12.2535 0.451184 7.29063 0.437512 4.57812C0.434778 3.86172 0.883216 3.26836 1.48478 3.01406L6.63634 0.829297C6.74845 0.777344 6.87423 0.75 7.00001 0.75ZM7.00001 2.57656V12.9125C10.7734 11.0859 11.7879 7.0418 11.8125 4.61641L7.00001 2.57656Z" fill="white"/>
                </svg>
            </div>
            <div class="tip-content">
                <h3 class="tip-title">Security Tip</h3>
                <p class="tip-text">Keep your password safe and don't share it with anyone. Consider using a password manager for better security.</p>
            </div>
        </div>

        <!-- Sign In Button -->
        <button class="btn-signin" @onclick="SignInAgain">
            Sign In Again
        </button>

        <!-- Help Link -->
        <div class="help-section">
            <span class="help-text">Need help?</span>
            <button type="button" class="help-link" @onclick="ContactSupport">Contact Support</button>
        </div>
    </div>
</div>

<style>
    .success-container {
        display: flex;
        flex-direction: column;
        min-height: 100vh;
        background: linear-gradient(90deg, #FFFFFF 0%, #F8FCFF 40%, #F0F8FF 70%, #E8F4FD 100%);
        font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
        position: relative;
    }

    .back-button {
        position: absolute;
        top: 20px;
        left: 20px;
        width: 40px;
        height: 40px;
        border-radius: 50%;
        background: #F3F4F6;
        border: none;
        display: flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        z-index: 10;
        transition: background-color 0.2s ease;
    }

    .back-button:hover {
        background: #E5E7EB;
    }

    .content-section {
        flex: 1;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        padding: 80px 24px 24px 24px;
        max-width: 400px;
        margin: 0 auto;
        width: 100%;
    }

    .icon-section {
        margin-bottom: 32px;
    }

    .icon-circle {
        width: 80px;
        height: 80px;
        background: #4ADE80;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .text-section {
        text-align: center;
        margin-bottom: 32px;
    }

    .main-title {
        font-size: 28px;
        font-weight: 700;
        color: #1F2937;
        margin: 0 0 12px 0;
        line-height: 1.2;
    }

    .description {
        font-size: 16px;
        color: #6B7280;
        margin: 0;
        line-height: 1.5;
    }

    .security-tip {
        display: flex;
        align-items: flex-start;
        gap: 12px;
        padding: 16px;
        background: #E0F7FF;
        border-radius: 12px;
        border: 1px solid #B3E5FC;
        margin-bottom: 24px;
        width: 100%;
    }

    .tip-icon {
        width: 32px;
        height: 32px;
        background: #3ABEF9;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
    }

    .tip-content {
        flex: 1;
    }

    .tip-title {
        font-size: 14px;
        font-weight: 600;
        color: #1F2937;
        margin: 0 0 4px 0;
    }

    .tip-text {
        font-size: 13px;
        color: #374151;
        margin: 0;
        line-height: 1.4;
    }

    .btn-signin {
        width: 100%;
        height: 48px;
        background: #3ABEF9;
        color: white;
        border: none;
        border-radius: 12px;
        font-size: 16px;
        font-weight: 600;
        cursor: pointer;
        transition: all 0.2s ease;
        margin-bottom: 24px;
        box-shadow: 0 4px 12px rgba(58, 190, 249, 0.3);
    }

    .btn-signin:hover {
        background: #2AA8E5;
        box-shadow: 0 6px 16px rgba(58, 190, 249, 0.4);
    }

    .help-section {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
    }

    .help-text {
        font-size: 14px;
        color: #6B7280;
    }

    .help-link {
        background: none;
        border: none;
        color: #3ABEF9;
        font-size: 14px;
        font-weight: 600;
        cursor: pointer;
        padding: 0;
    }

    .help-link:hover {
        text-decoration: underline;
    }
</style>

@code {
    private void GoBack()
    {
        TransitionService.RequestTransition("/create-password", GateSale.Services.TransitionType.SlideRight);
    }

    private void SignInAgain()
    {
        TransitionService.RequestTransition("/login", GateSale.Services.TransitionType.SlideLeft);
    }

    private void ContactSupport()
    {
        // Here you would navigate to support page or open support modal
        // For now, just show an alert
        // You can replace this with actual support functionality
    }
}
