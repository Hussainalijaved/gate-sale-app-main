@page "/forgot-password"
@inject NavigationManager Navigation
@inject GateSale.Services.PageTransitionService TransitionService

<div class="forgot-password-container">
    <!-- Back Button -->
    <button class="back-button" @onclick="GoBack">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none">
            <path d="M19 12H5M12 19L5 12L12 5" stroke="#6B7280" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
    </button>

    <!-- Main Content -->
    <div class="content-section">
        <!-- Icon -->
        <div class="icon-section">
            <div class="icon-circle">
                <svg width="30" height="31" viewBox="0 0 30 31" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <path d="M19.6875 21.375C25.3828 21.375 30 16.7578 30 11.0625C30 5.36719 25.3828 0.75 19.6875 0.75C13.9922 0.75 9.375 5.36719 9.375 11.0625C9.375 12.1582 9.54492 13.2188 9.86133 14.209L0.410156 23.6602C0.146484 23.9238 0 24.2812 0 24.6562V29.3438C0 30.123 0.626953 30.75 1.40625 30.75H6.09375C6.87305 30.75 7.5 30.123 7.5 29.3438V27H9.84375C10.623 27 11.25 26.373 11.25 25.5938V23.25H13.5938C13.9688 23.25 14.3262 23.1035 14.5898 22.8398L16.541 20.8887C17.5312 21.2051 18.5918 21.375 19.6875 21.375ZM22.0312 6.375C22.6529 6.375 23.249 6.62193 23.6885 7.06147C24.1281 7.50101 24.375 8.09715 24.375 8.71875C24.375 9.34035 24.1281 9.93649 23.6885 10.376C23.249 10.8156 22.6529 11.0625 22.0312 11.0625C21.4096 11.0625 20.8135 10.8156 20.374 10.376C19.9344 9.93649 19.6875 9.34035 19.6875 8.71875C19.6875 8.09715 19.9344 7.50101 20.374 7.06147C20.8135 6.62193 21.4096 6.375 22.0312 6.375Z" fill="#3ABEF9"/>
                </svg>
            </div>
        </div>

        <!-- Title and Description -->
        <div class="text-section">
            <h1 class="main-title">Forgot Password?</h1>
            <p class="description">No worries! Enter your email and we'll send you a reset link.</p>
        </div>

        <!-- Email Input -->
        <div class="input-section">
            <div class="input-group">
                <label class="input-label">Email Address</label>
                <div class="input-wrapper">
                    <input type="email" class="form-input" placeholder="Enter your email" @bind="Email" />
                    <svg class="input-icon" width="20" height="20" viewBox="0 0 24 24" fill="none">
                        <path d="M4 4H20C21.1 4 22 4.9 22 6V18C22 19.1 21.1 20 20 20H4C2.9 20 2 19.1 2 18V6C2 4.9 2.9 4 4 4Z" stroke="#AAAAAA" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                        <path d="M22 6L12 13L2 6" stroke="#AAAAAA" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                    </svg>
                </div>
            </div>
        </div>

        <!-- Error Message -->
        @if (!string.IsNullOrEmpty(errorMessage))
        {
            <div class="error-message" style="color: #EF4444; font-size: 14px; margin-bottom: 10px;">@errorMessage</div>
        }

        <!-- Send Reset Button -->
        <button class="btn-base btn-primary btn-send-reset" @onclick="SendResetCode" disabled="@isProcessing">
            @(isProcessing ? "Sending..." : "Send Reset Code")
        </button>

        <!-- Help Section -->
        <div class="help-section">
            <div class="help-icon">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none">
                    <path d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z" stroke="#10B981" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
            </div>
            <div class="help-content">
                <h3 class="help-title">Need Help?</h3>
                <p class="help-text">Check your spam folder or try a different email address. Still having trouble? Contact our support team.</p>
            </div>
        </div>
    </div>

    <!-- Footer -->
    <div class="footer-section">
        <p class="footer-text">Remember your password?</p>
        <button type="button" class="back-to-signin" @onclick="GoToSignIn">Back to Sign In</button>
    </div>
</div>

<style>
    .forgot-password-container {
        display: flex;
        flex-direction: column;
        min-height: 100vh;
        background: linear-gradient(90deg, #FFFFFF 0%, #F8FCFF 40%, #F0F8FF 70%, #E8F4FD 100%);
        font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
        position: relative;
    }

    .back-button {
        position: absolute;
        top: 20px;
        left: 20px;
        width: 40px;
        height: 40px;
        border-radius: 50%;
        background: #F3F4F6;
        border: none;
        display: flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        z-index: 10;
        transition: background-color 0.2s ease;
    }

    .back-button:hover {
        background: #E5E7EB;
    }

    .content-section {
        flex: 1;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        padding: 80px 24px 24px 24px;
        max-width: 400px;
        margin: 0 auto;
        width: 100%;
    }

    .icon-section {
        margin-bottom: 32px;
    }

    .icon-circle {
        width: 80px;
        height: 80px;
        background: #E0F7FF;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .text-section {
        text-align: center;
        margin-bottom: 32px;
    }

    .main-title {
        font-size: 28px;
        font-weight: 700;
        color: #1F2937;
        margin: 0 0 12px 0;
        line-height: 1.2;
    }

    .description {
        font-size: 16px;
        color: #6B7280;
        margin: 0;
        line-height: 1.5;
    }

    .input-section {
        width: 100%;
        margin-bottom: 24px;
    }

    .input-group {
        display: flex;
        flex-direction: column;
    }

    .input-label {
        font-size: 14px;
        font-weight: 600;
        color: #374151;
        margin-bottom: 8px;
    }

    .input-wrapper {
        position: relative;
        display: flex;
        align-items: center;
    }

    .input-icon {
        position: absolute;
        right: 16px;
        z-index: 2;
    }

    .form-input {
        width: 100%;
        height: 48px;
        padding: 12px 48px 12px 16px;
        border: 1px solid #D1D5DB;
        border-radius: 12px;
        font-size: 16px;
        color: #1F2937;
        background-color: #F9FAFB;
        box-sizing: border-box;
        transition: all 0.2s ease;
    }

    .form-input:focus {
        outline: none;
        border-color: #3ABEF9;
        box-shadow: 0 0 0 3px rgba(58, 190, 249, 0.1);
        background-color: #FFFFFF;
    }

    .form-input::placeholder {
        color: #9CA3AF;
    }

    .btn-send-reset {
        width: 100%;
        height: 48px;
        background: #3ABEF9;
        color: white;
        border: none;
        border-radius: 12px;
        font-size: 16px;
        font-weight: 600;
        cursor: pointer;
        transition: background-color 0.2s ease;
        margin-bottom: 24px;
    }

    .btn-send-reset:hover {
        background: #2AA8E5;
    }

    .help-section {
        display: flex;
        align-items: flex-start;
        gap: 12px;
        padding: 16px;
        background: #F9FAFB;
        border-radius: 12px;
        border: 1px solid #E5E7EB;
    }

    .help-icon {
        width: 32px;
        height: 32px;
        background: #D1FAE5;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
    }

    .help-content {
        flex: 1;
    }

    .help-title {
        font-size: 14px;
        font-weight: 600;
        color: #374151;
        margin: 0 0 4px 0;
    }

    .help-text {
        font-size: 13px;
        color: #6B7280;
        margin: 0;
        line-height: 1.4;
    }

    .footer-section {
        padding: 24px;
        text-align: center;
        background: transparent;
    }

    .footer-text {
        font-size: 14px;
        color: #6B7280;
        margin: 0 0 8px 0;
    }

    .back-to-signin {
        background: none;
        border: none;
        color: #3ABEF9;
        font-size: 14px;
        font-weight: 600;
        cursor: pointer;
        text-decoration: none;
    }

    .back-to-signin:hover {
        text-decoration: underline;
    }
</style>

@code {
    private string Email = "";

    private void GoBack()
    {
        TransitionService.RequestTransition("/login", GateSale.Services.TransitionType.SlideRight);
    }

    @inject GateSale.Services.Interfaces.IUserService UserService
    private bool isProcessing = false;
    private string errorMessage = "";

    private async Task SendResetCode()
    {
        if (string.IsNullOrWhiteSpace(Email))
        {
            errorMessage = "Please enter your email.";
            return;
        }

        isProcessing = true;
        errorMessage = "";

        var success = await UserService.ForgotPasswordAsync(Email);

        isProcessing = false;

        if (success)
        {
            TransitionService.RequestTransition($"/verification-code?email={Email}&mode=reset", GateSale.Services.TransitionType.SlideLeft);
        }
        else
        {
            errorMessage = "Failed to send reset code. Please try again.";
        }
    }

    private void GoToSignIn()
    {
        TransitionService.RequestTransition("/login", GateSale.Services.TransitionType.SlideRight);
    }
}
