@page "/order-details/{OrderId}"
@inject NavigationManager Navigation
@inject IOrderService OrderService
@inject IUserService UserService
@inject IPaymentService PaymentService
@inject IOrderTrackingService OrderTrackingService
@inject IPudoSimulationService PudoSimulationService
@inject PageTransitionService TransitionService
@using GateSale.Services.Interfaces
@using GateSale.Models
@using System.Collections.Generic
@using System.Linq

<div class="order-details-container">
    <!-- Header -->
    <div class="header">
        <button class="back-button" @onclick="GoBack">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none">
                <path d="M19 12H5" stroke="#000000" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
                <path d="M12 19L5 12L12 5" stroke="#000000" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
        </button>
        <h1 class="page-title">Order Details</h1>
        <div class="header-spacer"></div>
    </div>

    <div class="main-content">
        @if (isLoading)
        {
            <div class="loading-container">
                <div class="loading-spinner"></div>
                <p>Loading order details...</p>
            </div>
        }
        else if (errorMessage != null)
        {
            <div class="error-state">
                <p>@errorMessage</p>
                <button class="btn-primary" @onclick="LoadOrderDetails">Retry</button>
            </div>
        }
        else if (order != null)
        {
            <!-- Order Status Banner -->
            <div class="status-banner @GetStatusClass(order.Status)">
                <div class="status-icon">
                    @GetStatusIcon(order.Status)
                </div>
                <div class="status-info">
                    <h2 class="status-title">@order.StatusLabel</h2>
                    <p class="status-description">@GetStatusDescription(order.Status)</p>
                </div>
            </div>

            <!-- Product Card -->
            <div class="section-card">
                <h3 class="section-title">Product</h3>
                <div class="product-info">
                    <div class="product-image">
                        <img src="@order.ProductImageUrl" alt="@order.ProductTitle" />
                    </div>
                    <div class="product-details">
                        <h4 class="product-name">@order.ProductTitle</h4>
                        <p class="product-category">@order.Category @(string.IsNullOrEmpty(order.SubCategory) ? "" : $") > {order.SubCategory}")</p>
                        <div class="product-price">R @order.ItemSubtotal.ToString("F2")</div>
                    </div>
                </div>
            </div>

            <!-- Shipping Information -->
            <div class="section-card">
                <h3 class="section-title">Shipping Information</h3>
                <div class="shipping-info">
                    <div class="info-row">
                        <span class="info-label">Order Number:</span>
                        <span class="info-value">#@order.OrderNumber</span>
                    </div>
                    <div class="info-row">
                        <span class="info-label">Order Date:</span>
                        <span class="info-value">@order.OrderDate.ToString("MMM dd, yyyy HH:mm")</span>
                    </div>
                    @if (!string.IsNullOrEmpty(order.PudoTrackingNumber))
                    {
                        <div class="info-row">
                            <span class="info-label">Tracking Number:</span>
                            <span class="info-value highlight">@order.PudoTrackingNumber</span>
                        </div>
                    }
                    
                    <div class="locker-details mt-12">
                        <div class="locker-box">
                            <div class="locker-icon">
                                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                    <path d="M21 8V21H3V8" />
                                    <path d="M1 3H23V8H1V3Z" />
                                    <path d="M10 12H14" />
                                </svg>
                            </div>
                            <div class="locker-info">
                                <span class="locker-label">Drop-off Locker (Seller)</span>
                                <span class="locker-name">@order.SellerLocker?.Location</span>
                                <span class="locker-code">Code: @order.SellerLocker?.LockerCode</span>
                            </div>
                        </div>
                        <div class="locker-connector"></div>
                        <div class="locker-box">
                            <div class="locker-icon">
                                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                    <path d="M21 8V21H3V8" />
                                    <path d="M1 3H23V8H1V3Z" />
                                    <path d="M10 12H14" />
                                </svg>
                            </div>
                            <div class="locker-info">
                                <span class="locker-label">Collection Locker (Buyer)</span>
                                <span class="locker-name">@order.BuyerLocker?.Location</span>
                                <span class="locker-code">Code: @order.BuyerLocker?.LockerCode</span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            
            <!-- Tracking Timeline -->
            <div class="section-card">
                <h3 class="section-title">Order Tracking</h3>
                @if (trackingInfo != null && trackingInfo.Events.Any())
                {
                    <div class="tracking-timeline">
                        @foreach (var evt in trackingInfo.Events)
                        {
                            <div class="timeline-item">
                                <div class="timeline-marker"></div>
                                <div class="timeline-content">
                                    <div class="event-header">
                                        <span class="event-type">@evt.EventType</span>
                                        <span class="event-time">@evt.Timestamp.ToString("MMM dd, HH:mm")</span>
                                    </div>
                                    <p class="event-description">@evt.Description</p>
                                    @if (!string.IsNullOrEmpty(evt.Location))
                                    {
                                        <div class="event-location">
                                            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                                <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z" />
                                                <circle cx="12" cy="10" r="3" />
                                            </svg>
                                            <span>@evt.Location</span>
                                        </div>
                                    }
                                </div>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <p class="no-events">No tracking events yet.</p>
                }
            </div>

            <!-- Payment Summary -->
            <div class="section-card">
                <h3 class="section-title">Payment Summary</h3>
                <div class="payment-summary">
                    <div class="summary-row">
                        <span>Item Price</span>
                        <span>R @order.ItemSubtotal.ToString("F2")</span>
                    </div>
                    <div class="summary-row">
                        <span>Shipping Fee</span>
                        <span>R @order.ShippingCost.ToString("F2")</span>
                    </div>
                    @if (isSeller)
                    {
                        <div class="summary-row fee">
                            <span>Admin Fee (10%)</span>
                            <span>- R @order.AdminFeeAmount.ToString("F2")</span>
                        </div>
                        <div class="summary-row total payout">
                            <span>Your Payout</span>
                            <span>R @order.SellerPayoutAmount.ToString("F2")</span>
                        </div>
                    }
                    else
                    {
                        <div class="summary-row total">
                            <span>Total Amount</span>
                            <span>R @order.TotalAmount.ToString("F2")</span>
                        </div>
                    }
                </div>
            </div>

            <!-- Action Buttons -->
            <div class="actions-container">
                @if (isSeller)
                {
                    @if (order.Status == OrderStatus.PaidAwaitingShipment)
                    {
                        <button class="btn-primary full-width" @onclick="ShowShipmentDialog">Mark as Shipped</button>
                        <button class="btn-outline full-width mt-12" @onclick="CancelOrder">Cancel Order</button>
                    }
                }
                else
                {
                    @if (order.Status == OrderStatus.AwaitingPayment)
                    {
                        <button class="btn-primary full-width" @onclick="PayNow">Pay Now</button>
                        <button class="btn-outline-danger full-width mt-12" @onclick="CancelOrder">Cancel Order</button>
                    }
                    else if (order.Status == OrderStatus.Delivered || order.Status == OrderStatus.Collected)
                    {
                        <button class="btn-primary full-width" @onclick="ApproveOrder">Approve & Release Payment</button>
                        <button class="btn-outline-danger full-width mt-12" @onclick="InitiateDispute">Dispute Order</button>
                    }
                    else if (order.Status == OrderStatus.PaidAwaitingShipment)
                    {
                        <button class="btn-outline-danger full-width" @onclick="CancelOrder">Cancel Order</button>
                    }
                }

                <!-- Test Buttons (Visible for both for testing) -->
                <div class="test-actions mt-24">
                    <p class="test-label">Developer Test Actions:</p>
                    <div class="test-grid">
                        <button class="btn-test" @onclick="() => TestUpdateStatus(OrderStatus.Delivered)">Set Delivered</button>
                        <button class="btn-test" @onclick="() => TestUpdateStatus(OrderStatus.Collected)">Set Collected</button>
                    </div>
                </div>

                <!-- Simulation Actions (Testing Only) -->
                <div class="section-card simulation-section mt-24">
                    <h3 class="section-title">Pudo Simulation (Testing)</h3>
                    <div class="simulation-actions">
                        <button class="btn-outline full-width" @onclick="SimulatePudoDrop" disabled="@isProcessing">
                            @if (isProcessing) { <span class="spinner-small"></span> }
                            Simulate Pudo Drop (Delivered)
                        </button>
                        <button class="btn-outline full-width mt-12" @onclick="SimulatePudoPickup" disabled="@isProcessing">
                            @if (isProcessing) { <span class="spinner-small"></span> }
                            Simulate Pudo Pickup (Collected)
                        </button>
                    </div>
                </div>
            </div>
        }
    </div>

    <!-- Shipment Dialog -->
    @if (showShipmentDialog)
    {
        <div class="modal-overlay">
            <div class="modal-content">
                <h3 class="modal-title">Shipment Details</h3>
                <p class="modal-subtitle">Please enter the Pudo tracking information after dropping off the item.</p>
                
                <div class="form-group">
                    <label>Pudo Tracking Number</label>
                    <input type="text" @bind="trackingNumber" placeholder="e.g. PUDO12345678" />
                </div>
                
                <div class="form-group">
                    <label>Shipment Reference (Optional)</label>
                    <input type="text" @bind="shipmentReference" placeholder="e.g. GS-REF-001" />
                </div>

                @if (dialogError != null)
                {
                    <p class="dialog-error">@dialogError</p>
                }

                <div class="modal-actions">
                    <button class="btn-secondary" @onclick="HideShipmentDialog" disabled="@isProcessing">Cancel</button>
                    <button class="btn-primary" @onclick="ProcessShipment" disabled="@(string.IsNullOrEmpty(trackingNumber) || isProcessing)">
                        @if (isProcessing)
                        {
                            <span class="spinner-small"></span>
                        }
                        else
                        {
                            <span>Confirm Shipment</span>
                        }
                    </button>
                </div>
            </div>
        </div>
    }
</div>

<style>
