        text-align: center;
        padding: 20px 0;
    }

    .simulation-section {
        border: 1px dashed #3ABEF9;
        background-color: #F0F9FF;
    }

    .simulation-actions {
        display: flex;
        flex-direction: column;
        gap: 8px;
    }
</style>

@code {
    [Parameter] public string OrderId { get; set; } = string.Empty;

    private OrderDetailDto? order;
    private OrderTrackingInfo? trackingInfo;
    private bool isLoading = true;
    private string? errorMessage;
    private bool isSeller = false;
    private bool isProcessing = false;

    // Shipment Dialog
    private bool showShipmentDialog = false;
    private string trackingNumber = string.Empty;
    private string shipmentReference = string.Empty;
    private string? dialogError;

    protected override async Task OnInitializedAsync()
    {
        await LoadOrderDetails();
    }

    private async Task LoadOrderDetails()
    {
        try
        {
            isLoading = true;
            errorMessage = null;

            if (Guid.TryParse(OrderId, out var orderGuid))
            {
                order = await OrderService.GetOrderByIdAsync(orderGuid);
                
                if (order != null)
                {
                    var currentUser = await UserService.GetCurrentUserAsync();
                    if (currentUser != null)
                    {
                        var sellerOrders = await OrderService.GetSellerOrdersAsync();
                        isSeller = sellerOrders.Any(o => o.Id == orderGuid);
                    }

                    // Load tracking info
                    trackingInfo = await OrderTrackingService.GetOrderTrackingAsync(orderGuid);
                }
                else
                {
                    errorMessage = "Order not found.";
                }
            }
            else
            {
                errorMessage = "Invalid Order ID.";
            }

            isLoading = false;
            StateHasChanged();
        }
        catch (Exception ex)
        {
            errorMessage = "Failed to load order details.";
            Console.WriteLine($"Error: {ex.Message}");
            isLoading = false;
        }
    }

    private string GetStatusClass(OrderStatus status)
    {
        return status switch
        {
            OrderStatus.AwaitingPayment => "pending",
            OrderStatus.PaidAwaitingShipment => "pending",
            OrderStatus.InTransit => "transit",
            OrderStatus.Delivered => "delivered",
            OrderStatus.Collected => "delivered",
            OrderStatus.BuyerApproved => "delivered",
            OrderStatus.Completed => "delivered",
            OrderStatus.CancelledBySeller => "cancelled",
            OrderStatus.DisputeInProgress => "dispute",
            _ => "pending"
        };
    }

    private RenderFragment GetStatusIcon(OrderStatus status) => builder =>
    {
        builder.OpenElement(0, "svg");
        builder.AddAttribute(1, "width", "24");
        builder.AddAttribute(2, "height", "24");
        builder.AddAttribute(3, "viewBox", "0 0 24 24");
        builder.AddAttribute(4, "fill", "none");
        builder.AddAttribute(5, "stroke", "currentColor");
        builder.AddAttribute(6, "stroke-width", "2");

        switch (status)
        {
            case OrderStatus.AwaitingPayment:
                builder.AddContent(7, (MarkupString)"<circle cx='12' cy='12' r='10'/><line x1='12' y1='8' x2='12' y2='12'/><line x1='12' y1='16' x2='12.01' y2='16'/>");
                break;
            case OrderStatus.PaidAwaitingShipment:
                builder.AddContent(7, (MarkupString)"<circle cx='12' cy='12' r='10'/><polyline points='12 6 12 12 16 14'/>");
                break;
            case OrderStatus.InTransit:
                builder.AddContent(7, (MarkupString)"<rect x='1' y='3' width='15' height='13'/><polygon points='16 8 20 8 23 11 23 16 16 16 16 8'/><circle cx='5.5' cy='18.5' r='2.5'/><circle cx='18.5' cy='18.5' r='2.5'/>");
                break;
            case OrderStatus.Delivered:
            case OrderStatus.Collected:
            case OrderStatus.BuyerApproved:
            case OrderStatus.Completed:
                builder.AddContent(7, (MarkupString)"<polyline points='20 6 9 17 4 12'/>");
                break;
            default:
                builder.AddContent(7, (MarkupString)"<circle cx='12' cy='12' r='10'/><line x1='12' y1='8' x2='12' y2='12'/><line x1='12' y1='16' x2='12.01' y2='16'/>");
                break;
        }
        builder.CloseElement();
    };

    private string GetStatusDescription(OrderStatus status)
    {
        return status switch
        {
            OrderStatus.AwaitingPayment => "Order created. Please complete the payment to proceed.",
            OrderStatus.PaidAwaitingShipment => "Payment received. Seller needs to drop off the item at the Pudo locker.",
            OrderStatus.InTransit => "Item is on its way to the destination locker.",
            OrderStatus.Delivered => "Item has arrived at the destination locker and is ready for collection.",
            OrderStatus.Collected => "Buyer has collected the item from the locker.",
            OrderStatus.BuyerApproved => "Buyer has approved the item. Payout is being processed.",
            OrderStatus.Completed => "Order completed successfully.",
            OrderStatus.CancelledBySeller => "This order was cancelled by the seller.",
            OrderStatus.DisputeInProgress => "A dispute has been opened for this order.",
            _ => "Order is being processed."
        };
    }

    private void ShowShipmentDialog()
    {
        trackingNumber = string.Empty;
        shipmentReference = string.Empty;
        dialogError = null;
        showShipmentDialog = true;
    }

    private void HideShipmentDialog()
    {
        showShipmentDialog = false;
    }

    private async Task PayNow()
    {
        if (order == null || isProcessing) return;

        try
        {
            isProcessing = true;
            errorMessage = null;
            
            var paymentResult = await PaymentService.InitiatePaymentAsync(new InitiatePaymentRequest
            {
                OrderId = order.Id,
                ReturnUrl = $"{MauiProgram.ApiBaseUrl}payment-success",
                CancelUrl = $"{MauiProgram.ApiBaseUrl}payment-cancel"
            });

            if (paymentResult != null && paymentResult.Success && !string.IsNullOrEmpty(paymentResult.PaymentUrl))
            {
                await Launcher.Default.OpenAsync(paymentResult.PaymentUrl);
            }
            else
            {
                errorMessage = paymentResult?.Message ?? "Failed to initiate payment.";
            }
        }
        catch (Exception ex)
        {
            errorMessage = "An error occurred while initiating payment.";
            Console.WriteLine($"Error: {ex.Message}");
        }
        finally
        {
            isProcessing = false;
        }
    }

    private async Task ProcessShipment()
    {
        if (string.IsNullOrWhiteSpace(trackingNumber)) return;

        try
        {
            isProcessing = true;
            dialogError = null;

            var success = await OrderService.ProcessShipmentAsync(order!.Id, trackingNumber, shipmentReference);
            
            if (success)
            {
                showShipmentDialog = false;
                await LoadOrderDetails();
            }
            else
            {
                dialogError = "Failed to update shipment. Please try again.";
            }
        }
        catch (Exception ex)
        {
            dialogError = $"Error: {ex.Message}";
        }
        finally
        {
            isProcessing = false;
        }
    }

    private async Task ApproveOrder()
    {
        try
        {
            isProcessing = true;
            var success = await OrderService.ApproveOrderAsync(order!.Id);
            if (success)
            {
