@page "/profile"
@inject NavigationManager Navigation
@inject IUserService UserService
@inject ISchoolService SchoolService
@inject GateSale.Services.PageTransitionService TransitionService
@using GateSale.Services.Interfaces
@using GateSale.Models

<div class="profile-container">
    <!-- Header -->
    <div class="header">
        <h1 class="greeting">Hi, @(currentUser?.FirstName ?? "User")! 👋</h1>
        <p class="school-info">@(currentUser?.SchoolName ?? "School") • Grade @(currentUser?.Grade ?? "")</p>
    </div>
    
    <!-- Parental Consent Alert -->
    @if ((currentUser?.Grade == "8" || currentUser?.Grade == "9") && !currentUser.ParentalConsentGiven)
    {
        <div class="alert-banner">
            <div class="alert-icon">
                <svg width="12" height="12" viewBox="0 0 12 12" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <path d="M6 0C9.31371 0 12 2.68629 12 6C12 9.31371 9.31371 12 6 12C2.68629 12 0 9.31371 0 6C0 2.68629 2.68629 0 6 0Z" fill="#EAB308" />
                    <path d="M6 0C9.31371 0 12 2.68629 12 6C12 9.31371 9.31371 12 6 12C2.68629 12 0 9.31371 0 6C0 2.68629 2.68629 0 6 0Z" stroke="#E5E7EB" />
                </svg>
            </div>
            <div class="alert-content">
                <h3 class="alert-title">Awaiting Parental Consent</h3>
                <p class="alert-subtitle">Some features are limited until approval</p>
            </div>
        </div>
    }

    @if (isLoading)
    {
        <div class="loading-overlay">
            <div class="spinner"></div>
            <p>Loading profile...</p>
        </div>
    }

    <!-- Menu Items -->
    <div class="menu-section">
        <div class="menu-item" @onclick="NavigateToMyListings">
            <div class="menu-icon blue">
                <svg width="16" height="19" viewBox="0 0 16 19" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <g clip-path="url(#clip0_2_1087)">
                        <path d="M1.90742 2.30664L0.125 5.875H7.4375V1.375H3.41914C2.7793 1.375 2.1957 1.73711 1.90742 2.30664ZM8.5625 5.875H15.875L14.0926 2.30664C13.8043 1.73711 13.2207 1.375 12.5809 1.375H8.5625V5.875ZM15.875 7H0.125V14.875C0.125 16.116 1.13398 17.125 2.375 17.125H13.625C14.866 17.125 15.875 16.116 15.875 14.875V7Z" fill="#3ABEF9" />
                    </g>
                    <defs>
                        <clipPath id="clip0_2_1087">
                            <path d="M0.125 0.25H15.875V18.25H0.125V0.25Z" fill="white" />
                        </clipPath>
                    </defs>
                </svg>
            </div>
            <div class="menu-content">
                <h3 class="menu-title">My Listings</h3>
                <p class="menu-subtitle">Manage your posted items</p>
            </div>
            <div class="menu-arrow">›</div>
        </div>

        <div class="menu-item" @onclick="NavigateToMyPurchases">
            <div class="menu-icon green">
                <svg width="16" height="19" viewBox="0 0 16 19" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <g clip-path="url(#clip0_2_1100)">
                        <path d="M5.75 4.1875C5.75 2.94648 6.75898 1.9375 8 1.9375C9.24102 1.9375 10.25 2.94648 10.25 4.1875V5.875H5.75V4.1875ZM4.0625 5.875H1.8125C0.880859 5.875 0.125 6.63086 0.125 7.5625V14.875C0.125 16.7383 1.63672 18.25 3.5 18.25H12.5C14.3633 18.25 15.875 16.7383 15.875 14.875V7.5625C15.875 6.63086 15.1191 5.875 14.1875 5.875H11.9375V4.1875C11.9375 2.01133 10.1762 0.25 8 0.25C5.82383 0.25 4.0625 2.01133 4.0625 4.1875V5.875ZM4.90625 7.5625C5.13003 7.5625 5.34464 7.65139 5.50287 7.80963C5.66111 7.96786 5.75 8.18247 5.75 8.40625C5.75 8.63003 5.66111 8.84464 5.50287 9.00287C5.34464 9.16111 5.13003 9.25 4.90625 9.25C4.68247 9.25 4.46786 9.16111 4.30963 9.00287C4.15139 8.84464 4.0625 8.63003 4.0625 8.40625C4.0625 8.18247 4.15139 7.96786 4.30963 7.80963C4.46786 7.65139 4.68247 7.5625 4.90625 7.5625ZM10.25 8.40625C10.25 8.18247 10.3389 7.96786 10.4971 7.80963C10.6554 7.65139 10.87 7.5625 11.0938 7.5625C11.3175 7.5625 11.5321 7.65139 11.6904 7.80963C11.8486 7.96786 11.9375 8.18247 11.9375 8.40625C11.9375 8.63003 11.8486 8.84464 11.6904 9.00287C11.5321 9.16111 11.3175 9.25 11.0938 9.25C10.87 9.25 10.6554 9.16111 10.4971 9.00287C10.3389 8.84464 10.25 8.63003 10.25 8.40625Z" fill="#4ADE80" />
                    </g>
                    <defs>
                        <clipPath id="clip0_2_1100">
                            <path d="M0.125 0.25H15.875V18.25H0.125V0.25Z" fill="white" />
                        </clipPath>
                    </defs>
                </svg>
            </div>
            <div class="menu-content">
                <h3 class="menu-title">My Purchases</h3>
                <p class="menu-subtitle">View your purchase history</p>
            </div>
            <div class="menu-arrow">›</div>
        </div>

        <div class="menu-item" @onclick="NavigateToMyOrders">
            <div class="menu-icon purple">
                <svg width="16" height="19" viewBox="0 0 16 19" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <g clip-path="url(#clip0_2_1200)">
                        <path d="M14 2.25H2C1.17157 2.25 0.5 2.92157 0.5 3.75V16.75C0.5 17.5784 1.17157 18.25 2 18.25H14C14.8284 18.25 15.5 17.5784 15.5 16.75V3.75C15.5 2.92157 14.8284 2.25 14 2.25Z" stroke="#9333EA" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                        <path d="M4 0.25V4.25" stroke="#9333EA" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                        <path d="M12 0.25V4.25" stroke="#9333EA" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                        <path d="M0.5 8.25H15.5" stroke="#9333EA" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                        <path d="M4 12.25H5" stroke="#9333EA" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                        <path d="M8 12.25H9" stroke="#9333EA" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                        <path d="M12 12.25H13" stroke="#9333EA" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                    </g>
                    <defs>
                        <clipPath id="clip0_2_1200">
                            <rect width="16" height="19" fill="white"/>
                        </clipPath>
                    </defs>
                </svg>
            </div>
            <div class="menu-content">
                <h3 class="menu-title">My Orders</h3>
                <p class="menu-subtitle">Track your order status</p>
            </div>
            <div class="menu-arrow">›</div>
        </div>

        <div class="menu-item" @onclick="NavigateToMyLockers">
            <div class="menu-icon blue">
                <svg width="16" height="19" viewBox="0 0 24 24" fill="none" stroke="#3ABEF9" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M21 8V21H3V8" />
                    <path d="M1 3H23V8H1V3Z" />
                    <path d="M10 12H14" />
                </svg>
            </div>
            <div class="menu-content">
                <h3 class="menu-title">My Lockers</h3>
                <p class="menu-subtitle">Manage favorite & default lockers</p>
            </div>
            <div class="menu-arrow">›</div>
        </div>

        <div class="menu-item" @onclick="NavigateToSettings">
            <div class="menu-icon orange">
                <svg width="18" height="19" viewBox="0 0 18 19" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <g clip-path="url(#clip0_2_1113)">
