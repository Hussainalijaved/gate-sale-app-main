@code {
    private User? currentUser;
    private School? currentSchool;
    private bool isLoading = true;

    protected override async Task OnInitializedAsync()
    {
        System.Diagnostics.Debug.WriteLine("[Profile] OnInitializedAsync started");
        try 
        {
            isLoading = true;
            // Load current user from service
            System.Diagnostics.Debug.WriteLine("[Profile] Calling GetCurrentUserAsync...");
            currentUser = await UserService.GetCurrentUserAsync();
            System.Diagnostics.Debug.WriteLine($"[Profile] GetCurrentUserAsync returned: {currentUser != null}");
            
            if (currentUser != null)
            {
                System.Diagnostics.Debug.WriteLine($"[Profile] User data: FirstName='{currentUser.FirstName}', SchoolName='{currentUser.SchoolName}', Grade='{currentUser.Grade}'");
                // Try to load school info
                currentSchool = await SchoolService.GetSchoolByIdAsync(currentUser.SchoolId);
            }
            else
            {
                System.Diagnostics.Debug.WriteLine("[Profile] currentUser is NULL!");
            }
        }
        catch (Exception ex)
        {
            System.Diagnostics.Debug.WriteLine($"[Profile] Exception: {ex.Message}");
        }
        finally
        {
            isLoading = false;
            System.Diagnostics.Debug.WriteLine("[Profile] OnInitializedAsync completed");
        }
    }

    private bool showLogoutModal = false;
    private bool isLoggingOut = false;
    
    private void ShowLogoutConfirmation()
    {
        showLogoutModal = true;
    }

    private void HideLogoutConfirmation()
    {
        showLogoutModal = false;
    }

    private async Task HandleLogout()
    {
        if (isLoggingOut) return;
        
        try
        {
            isLoggingOut = true;
            await UserService.LogoutUserAsync();
            Navigation.NavigateTo("/login");
        }
        catch (Exception ex)
        {
            System.Diagnostics.Debug.WriteLine($"Logout error: {ex.Message}");
            showLogoutModal = false;
            isLoggingOut = false;
            await App.Current.MainPage.DisplayAlert("Error", "Failed to logout. Please try again.", "OK");
        }
    }
    
    private void NavigateToMyListings()
    {
        TransitionService.RequestTransition("/my-listings", GateSale.Services.TransitionType.SlideLeft);
    }
    
    private void NavigateToMyPurchases()
