</style>
@code {
    [Parameter] public string? ProductId { get; set; }

    private ProductDetail? currentProduct;
    private int currentImageIndex = 0;
    private double touchStartX = 0;
    private double mouseStartX = 0;
    private bool isDragging = false;

    private bool IsFavorite => currentProduct != null && FavoriteService.IsFavorite(currentProduct.Id);

    protected override async Task OnInitializedAsync()
    {
        // Load product details from service
        if (!string.IsNullOrEmpty(ProductId))
        {
            currentProduct = await ProductService.GetProductDetailByIdAsync(ProductId);
        }
        else
        {
            // Default to headphone if no ProductId specified (for backward compatibility)
            currentProduct = await ProductService.GetProductDetailByIdAsync("headphone");
        }
    }

    private List<string> GetImageUrls()
    {
        if (currentProduct == null) return new List<string>();

        // If ImageUrls list has items, use it; otherwise fall back to single ImageUrl
        if (currentProduct.ImageUrls.Any())
        {
            return currentProduct.ImageUrls;
        }
        else if (!string.IsNullOrEmpty(currentProduct.ImageUrl))
        {
            return new List<string> { currentProduct.ImageUrl };
        }

        return new List<string>();
    }

    // Image navigation methods
    private void NextImage()
    {
        var imageUrls = GetImageUrls();
        if (currentImageIndex < imageUrls.Count - 1)
        {
            currentImageIndex++;
            StateHasChanged();
        }
    }

    private void PreviousImage()
    {
        if (currentImageIndex > 0)
        {
            currentImageIndex--;
            StateHasChanged();
        }
    }

    private void GoToImage(int index)
    {
        var imageUrls = GetImageUrls();
        if (index >= 0 && index < imageUrls.Count)
        {
            currentImageIndex = index;
            StateHasChanged();
        }
    }

    // Touch/swipe event handlers
    private void OnTouchStart(TouchEventArgs e)
    {
        if (e.Touches.Length > 0)
        {
            touchStartX = e.Touches[0].ClientX;
        }
    }

    private void OnTouchEnd(TouchEventArgs e)
    {
        if (e.ChangedTouches.Length > 0)
        {
            var touchEndX = e.ChangedTouches[0].ClientX;
            var deltaX = touchStartX - touchEndX;

            // Minimum swipe distance to trigger navigation
            if (Math.Abs(deltaX) > 50)
            {
                if (deltaX > 0)
                {
                    NextImage(); // Swipe left - next image
                }
                else
                {
                    PreviousImage(); // Swipe right - previous image
                }
            }
        }
    }

    // Mouse event handlers for desktop
    private void OnMouseDown(MouseEventArgs e)
    {
        mouseStartX = e.ClientX;
        isDragging = true;
    }

    private void OnMouseUp(MouseEventArgs e)
    {
        if (isDragging)
        {
            var deltaX = mouseStartX - e.ClientX;

            // Minimum drag distance to trigger navigation
            if (Math.Abs(deltaX) > 50)
            {
                if (deltaX > 0)
                {
                    NextImage(); // Drag left - next image
                }
                else
                {
                    PreviousImage(); // Drag right - previous image
                }
            }
            isDragging = false;
        }
    }

    private void ToggleFavorite()
    {
        if (currentProduct != null)
        {
            var favoriteItem = new FavoriteItem
            {
                Id = currentProduct.Id,
                Title = currentProduct.Title,
                Price = currentProduct.CurrentPrice,
                Details = currentProduct.Description,
                ImageUrl = currentProduct.ImageUrl,
                IsVerified = currentProduct.IsVerified,
                Rating = currentProduct.Rating
            };

            FavoriteService.ToggleFavorite(favoriteItem);
            StateHasChanged(); // Refresh the UI to show the updated favorite state
        }
    }

    private void Sell()
    {
        if (currentProduct != null)
        {
            TransitionService.RequestTransition($"/checkout/{currentProduct.Id}", GateSale.Services.TransitionType.SlideLeft);
        }
    }
    
    private string GetTotalPrice()
    {
        if (currentProduct == null) return "R 0.00";
        
        // Extract numeric value from price
        decimal productPrice = 0;
        string priceText = currentProduct.CurrentPrice;
        
        // Remove non-numeric characters except decimal point
        var cleanPrice = new string(priceText.Where(c => char.IsDigit(c) || c == '.').ToArray());
        decimal.TryParse(cleanPrice, out productPrice);
        
        // Fixed delivery fee of R100
        decimal deliveryFee = 100;
        
        // Calculate total
        decimal total = productPrice + deliveryFee;
        
        return $"R {total:F2}";
    }

    private void Back()
    {
        TransitionService.RequestTransition("/shop", GateSale.Services.TransitionType.SlideRight);
    }

}