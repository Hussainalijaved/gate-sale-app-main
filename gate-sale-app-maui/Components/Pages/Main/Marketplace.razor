@code{
    // Tab functionality
    private string activeTab = "";

    private async Task SetActiveTab(string tabName)
    {
        activeTab = tabName;
        await FilterItems();
    }

    private void NavigateToProductDetails(string productId)
    {
        // Navigate to PageDetails with the product ID
        TransitionService.RequestTransition($"/pagedetails/{productId}", GateSale.Services.TransitionType.SlideLeft);
    }

    private async Task NavigateToCategory(string category)
    {
        // Filter locally on the marketplace page
        await SetActiveTab(category);
    }


    // Search functionality
    private string _searchQuery = "";
    private string searchQuery
    {
        get => _searchQuery;
        set
        {
            _searchQuery = value;
            _ = FilterItems();
        }
    }
    private List<TrendingItem> allTrendingItems = new();
    private List<TrendingItem> filteredTrendingItems = new();
    private List<RecentListing> recentListings = new();
    private List<Category> categories = new();

    // Filter modal
    private bool showFilterModal = false;

    // Filter options
    private decimal? minPrice = null;
    private decimal? maxPrice = null;
    private bool filterNew = false;
    private bool filterLikeNew = false;
    private bool filterGood = false;
    private bool filterFair = false;
    private bool filterGrade9 = false;
    private bool filterGrade10 = false;
    private bool filterGrade11 = false;
    private bool filterGrade12 = false;

    private bool HasActiveFilters =>
        minPrice.HasValue || maxPrice.HasValue ||
        filterNew || filterLikeNew || filterGood || filterFair ||
        filterGrade9 || filterGrade10 || filterGrade11 || filterGrade12;

    // Using Models.TrendingItem and Models.RecentListing from services

    protected override async Task OnInitializedAsync()
    {
        // Load selling categories - these match what products are created with
        var sellingCategories = await CategoryService.GetSellingCategoriesAsync();
        categories = sellingCategories.Select(sc => new Category
        {
            Id = sc.Id,
            Name = sc.Name,
            DisplayName = sc.DisplayName,
            IconEmoji = sc.IconEmoji,
            Color = sc.Color,
            IsActive = sc.IsActive,
            SortOrder = sc.SortOrder
        }).ToList();
        
        allTrendingItems = await ProductService.GetTrendingItemsAsync();
        filteredTrendingItems = allTrendingItems.ToList();
        recentListings = await ProductService.GetRecentListingsAsync();
    }


    private async Task FilterItems()
    {
        var filter = new ProductFilter
        {
            MinPrice = minPrice,
            MaxPrice = maxPrice,
            SearchTerm = searchQuery,
            Category = string.IsNullOrEmpty(activeTab) ? null : activeTab,
            Conditions = new List<string>(),
            Grades = new List<string>()
        };

        if (filterNew) filter.Conditions.Add("New");
        if (filterLikeNew) filter.Conditions.Add("Like New");
        if (filterGood) filter.Conditions.Add("Good");
        if (filterFair) filter.Conditions.Add("Fair");

        if (filterGrade9) filter.Grades.Add("Grade 9");
        if (filterGrade10) filter.Grades.Add("Grade 10");
        if (filterGrade11) filter.Grades.Add("Grade 11");
        if (filterGrade12) filter.Grades.Add("Grade 12");

        filteredTrendingItems = await ProductService.GetFilteredTrendingItemsAsync(filter);
        
        // Also filter recent listings if a category is selected
        var allRecent = await ProductService.GetRecentListingsAsync();
        if (!string.IsNullOrEmpty(activeTab))
        {
            recentListings = allRecent.Where(r => r.Category.Equals(activeTab, StringComparison.OrdinalIgnoreCase)).ToList();
        }
        else
        {
            recentListings = allRecent;
        }

        StateHasChanged();
    }

    private void ToggleFilterModal()
    {
        showFilterModal = !showFilterModal;
    }

    private void CloseFilterModal()
    {
        showFilterModal = false;
    }

    private void ClearFilters()
    {
        minPrice = null;
        maxPrice = null;
        filterNew = false;
        filterLikeNew = false;
        filterGood = false;
        filterFair = false;
        filterGrade9 = false;
        filterGrade10 = false;
        filterGrade11 = false;
        filterGrade12 = false;
        FilterItems();
    }

    private void ApplyFilters()
    {
        FilterItems();
        CloseFilterModal();
    }

    private void ToggleFavorite(RecentListing listing)
    {
        var favoriteItem = new FavoriteItem
        {
            Id = listing.Id,
            Title = listing.Title,
            Price = listing.Price,
            Details = listing.Details,
            ImageUrl = listing.ImageUrl,
            IsVerified = listing.IsVerified,
            Rating = listing.Rating
        };

        FavoriteService.ToggleFavorite(favoriteItem);
        StateHasChanged();
    }

    private void GoToFavorites()
    {
        TransitionService.RequestTransition("/favorites", GateSale.Services.TransitionType.Fade);
    }

    private void Sell()
    {
        TransitionService.RequestTransition("/what-are-you-selling", GateSale.Services.TransitionType.Fade);
    }
    private void Shop()
    {
        TransitionService.RequestTransition("/shop", GateSale.Services.TransitionType.Fade);
    }
    private void Profile()
    {
        TransitionService.RequestTransition("/profile", GateSale.Services.TransitionType.Fade);
    }
    private void SeeAll()
    {
        TransitionService.RequestTransition("/shop", GateSale.Services.TransitionType.SlideLeft);
    }

    private void SeeAllCategories()
    {
        TransitionService.RequestTransition("/shop", GateSale.Services.TransitionType.SlideLeft);
    }
}